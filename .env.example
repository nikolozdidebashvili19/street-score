NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=replace-with-a-generated-secret
MONGO_URI=mongodb://localhost:27017/nextjs-starter

# Google OAuth — https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open data services — respect fair-use policies (bulk import + cache)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=StreetPulse/0.1 (contact@example.com)

# Optional: override DNS for mongodb+srv lookups if Node cannot resolve SRV records
# If you see querySrv ECONNREFUSED, try 8.8.8.8,1.1.1.1
# DNS_SERVERS=8.8.8.8,1.1.1.1
